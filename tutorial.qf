DEFINE DIMENSION PLArticle
  HIERARCHY:
    REVENUE ID 1
      Product Sales ID 2
      Service Revenue
    COST OF GOODS SOLD ID 4
      Direct Materials ID 5
      Direct Labor ID 6
      Other Direct Costs ID 7
    GROSS PROFIT ID 8
    GROSS MARGIN (%) ID 9
    OPERATING EXPENSES ID 10
    OPERATING INCOME ID 11
    OPERATING MARGIN (%) ID 12
;

