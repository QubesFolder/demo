--171*55*6*136*1006*296=2.285275956×10¹²
--more than Two Trillion of value cells, each of 7 measures. Strictly saying is almost 16 TRILLION of cells of 7 dimensions.
DEFINE CUBE Sales_table
  DIMENSIONS:
    Currency
    Product
    Period
    Contract
    Client
    Site
  MEASURES:
    amount
    qty
    price
    tax
    amount_tax
    payment
    debt
  FROM:
    Sales
;

DEFINE CUBE Exchrate_table
  DIMENSIONS:
    Currency
    Period
  MEASURES:
    rate
  FROM:
    Exchrate
;

DEFINE CUBE Sales_amounts
  DIMENSIONS:
    Currency
    Product
    Period
    Contract
    Client
    Site
  VALUE:
    SUM(amount)
  FROM:
    Sales_table
  ROLLUP:
    Currency
    Product
    Period
    Contract
    Client
    Site
  ;

DEFINE CUBE Sales_base
  DIMENSIONS:
    Currency
    Product
    Period
    Contract
    Client
    Site
  MEASURES:
    amount = SUM(amount)
    qty = SUM(qty)
    price = amount / qty
    tax = SUM(tax)
    amount_tax = amount * (tax * 0.01)
    payment = SUM(payment)
    debt = amount - payment
  FROM:
    Sales_table
  ;

DEFINE CUBE Sales_cons
  DIMENSIONS:
    Currency
    Product
    Period
    Contract
    Client
    Site
  MEASURES:
    amount = SUM(amount)
    qty = SUM(qty)
    price = ROUND(amount / GREATEST(qty, 1),1)
    tax = SUM(tax)
    amount_tax = SUM(amount_tax)
    payment = SUM(payment)
    debt = SUM(debt)
  FROM:
    Sales_base
  ROLLUP:
    Currency
    Product
    Period
    Contract
    Client
    Site
;

DEFINE CUBE Sales_pl
  DIMENSIONS:
    PLArticle = 2
    Currency
    Product
    Period
    Contract
    Client
    Site
  VALUE:
    SUM(amount*rate)
  FROM: Sales_base
  JOIN: Exchrate_table
  ROLLUP:
    PLArticle
    Currency
    Product
    Period
    Contract
    Client
    Site
;

DEFINE CUBE ProfitLoss
  DIMENSIONS:
    PLArticle
    Currency
    Product
    Period
    Contract
    Client
    Site
  FROM:
    Sales_pl
  TAGS:
    revenue = SUM(PLArticle[1])
    cogs = SUM(PLArticle[4])
    operating_expenses = SUM(PLArticle[10])
  VALUE: 
    PLArticle[8] = revenue - cogs
    PLArticle[9] = round(100 * (revenue - cogs) / revenue, 1) 
    PLArticle[11] = revenue - cogs - operating_expenses
    PLArticle[12] = round(100 * (revenue - cogs - operating_expenses) / revenue, 1)
    SUM(value)
;

DEFINE VIEW 'Sales Contracts' 
  FROM: 
    Sales_cons
  ROWS:
    Contract
  COLUMNS:
    MEASURES BY Period
  MEASURES:
    amount LABEL 'Amount'
    qty LABEL 'Quantity'
    price LABEL 'Price'
    tax LABEL 'Tax percent'
    amount_tax LABEL 'Tax'
    payment LABEL 'Payment'
    debt LABEL 'Debt'
;

DEFINE VIEW 'Sales Products' 
  FROM: 
    Sales_cons
  ROWS:
    Product
  COLUMNS:
    MEASURES BY Month
  MEASURES:
    amount LABEL 'Amount'
    qty LABEL 'Quantity'
    price LABEL 'Price'
    tax LABEL 'Tax percent'
    amount_tax LABEL 'Tax'
    payment LABEL 'Payment'
    debt LABEL 'Debt'
;

DEFINE VIEW 'PL MST'
  FROM: ProfitLoss
  ROWS: PLArticle
  COLUMNS: Period
;

DEFINE VIEW 'Exchrates'
  FROM: Exchrate_table
  ROWS: Month
  COLUMNS: Currency
;
